# Python bytecode, tooling caches, and virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.env
.env.*
!.env.example

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tokenized datasets: keep only lightweight audit and metadata files
artifacts/pretraining_data/*
!artifacts/pretraining_data/metadata.json
!artifacts/pretraining_data/token_audit.json
artifacts/pretraining_data_smoke/
*.bin
*.npy
*.tmp

# Large checkpoints and model weight exports
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Local accelerator, logging, and cache directories
wandb/
runs/
.cache/
.huggingface/
modal_volumes/

# Potentially large per-example harness outputs (keep aggregate JSON)
benchmark_results/**/samples_*.jsonl

# Local generated scratch files
*.log
